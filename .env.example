# ==============================================================================
# Sugen Technologies - ICD-11 Autonomous Coding Environment Configuration
# ==============================================================================
# Copy this file to .env and insert your API keys:
#   cp .env.example .env
#
# NOTE: .env is ignored by git and will NEVER be committed or leaked to GitHub.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Model API Keys (Optional - System works 100% offline without keys)
# ------------------------------------------------------------------------------
# OpenAI API Key (gpt-4o-mini candidate reranker)
OPENAI_API_KEY=

# Anthropic Claude API Key (claude-3-haiku-20240307 candidate reranker)
ANTHROPIC_API_KEY=

# ------------------------------------------------------------------------------
# 2. Network Proxy (Optional - Used on the hidden evaluation grading box)
# ------------------------------------------------------------------------------
# HTTPS_PROXY=http://proxy.sugen.internal:8080
# HTTP_PROXY=http://proxy.sugen.internal:8080

# ------------------------------------------------------------------------------
# 3. Local Web Dashboard Server Configuration
# ------------------------------------------------------------------------------
HOST=127.0.0.1
PORT=8000
